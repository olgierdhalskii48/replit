# Development docker env (do not commit real secrets)
DEV_MODE=true
POSTGRES_DB=legal_services_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_password

# For local testing - override in CI/prod
JWT_SECRET_KEY=replace_with_generated_secret_for_local_dev
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
DATABASE_URL=postgresql://postgres:dev_password@postgres:5432/legal_services_dev