# Example environment file — do NOT commit real secrets
# Development
DEV_MODE=true

# App secrets
JWT_SECRET_KEY=change-me-replace-with-strong-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS / Hosts
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (dev)
DATABASE_URL=sqlite:///./dev.db

# Email / SMS (stubs)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=